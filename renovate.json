{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "prCreation": "immediate",
  "baseBranchPatterns": ["main"],
  "platformAutomerge": true,
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "assignees": ["W4D-cmd"],
    "schedule": ["at any time"],
    "groupName": null
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Always auto-merge security updates if CI was successful",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "vulnerabilityAlerts": {
        "enabled": true
      },
      "automerge": true
    },
    {
      "description": "katex is pinned to 0.16.47 on purpose: react-katex, rehype-katex and micromark-extension-math peer-depend on ^0.16, and 0.19 changed CSS class names (base/strut -> katex-base/katex-strut), splitting the install into two copies. Renovate must not touch it; re-enable when the renderer ecosystem supports 0.19.",
      "matchPackageNames": ["katex"],
      "enabled": false
    },
    {
      "groupName": "Next.js and React stack",
      "groupSlug": "nextjs-react-stack",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "eslint-config-next",
        "/^@next//",
        "/^@types/react/",
        "/^@types/react-dom/"
      ]
    },
    {
      "groupName": "Tailwind CSS stack",
      "groupSlug": "tailwindcss-stack",
      "matchPackageNames": [
        "tailwindcss",
        "postcss",
        "autoprefixer",
        "/^@tailwindcss//"
      ]
    },
    {
      "groupName": "Docker image updates",
      "groupSlug": "docker-images",
      "matchDatasources": ["docker"]
    },
    {
      "description": "Hold python docker base below 3.15 - onnxruntime has no 3.15 wheels yet",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ],
  "dockerfile": {
    "enabled": true
  },
  "docker-compose": {
    "enabled": true
  }
}
